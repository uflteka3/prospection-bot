# ============ WhatsApp ============
# Ton numéro perso, avec l'indicatif, sans le "+" (ex. 22670000000).
# Seul ce numéro peut donner des ordres au robot. Plusieurs numéros : séparés par des virgules.
OWNER_NUMBER=226XXXXXXXX
# Optionnel : identifiant @lid de ton compte si le robot ignore tes messages (il l'affiche dans les logs)
# OWNER_LID=
# Optionnel : lier WhatsApp avec un code au lieu du QR (numéro de la SIM du robot)
# PAIRING_NUMBER=226YYYYYYYY
# Mot de passe de la page /qr (obligatoire pour lier WhatsApp à distance)
ADMIN_TOKEN=change-moi-par-un-long-mot-de-passe

# ============ IA : n'importe quelle API ============
# LLM_PROVIDER : anthropic | openai | groq | openrouter | mistral | deepseek | together | gemini | xai
#                | ollama | lmstudio | custom (tout service compatible OpenAI) | raw (toute autre API HTTP)
LLM_PROVIDER=anthropic
LLM_API_KEY=ta_cle_api
# Nom exact du modèle chez ton fournisseur (voir sa documentation)
LLM_MODEL=nom-du-modele

# Pour custom / ollama distant / proxy : adresse de l'API
# LLM_BASE_URL=https://mon-service.example.com/v1
# Si ton service parle le format Anthropic : LLM_FORMAT=anthropic
# Modèle sans appel d'outils : le robot simule les outils par le texte
# LLM_TOOLS=prompt
# En-têtes supplémentaires (JSON), ex. pour OpenRouter
# LLM_HEADERS={"HTTP-Referer":"https://diaodev.com"}

# --- Mode raw : toute autre API HTTP (exemple Gemini natif) ---
# LLM_PROVIDER=raw
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models/{{model}}:generateContent?key={{key}}
# LLM_REQUEST_TEMPLATE={"contents":[{"parts":[{"text":"{{prompt}}"}]}]}
# LLM_RESPONSE_PATH=candidates.0.content.parts.0.text
# Variables utilisables : {{prompt}} {{system}} {{model}} {{key}} {{max_tokens}}

# ============ Recherche web : n'importe quelle API ============
# SEARCH_PROVIDER : serper | brave | tavily | searxng | duckduckgo (sans clé) | custom
# Si tu ne mets rien : choisi selon SERPER_API_KEY / BRAVE_API_KEY / TAVILY_API_KEY, sinon DuckDuckGo
SEARCH_PROVIDER=serper
SEARCH_API_KEY=ta_cle_recherche
SEARCH_CITY=Ouagadougou
# SEARCH_COUNTRY=bf
# SEARCH_LANG=fr

# --- Mode custom : toute autre API de recherche ---
# SEARCH_URL=https://api.exemple.com/search?q={query}&key={key}
# SEARCH_METHOD=GET
# SEARCH_HEADERS={"Authorization":"Bearer {key}"}
# SEARCH_BODY={"query":"{query}"}
# SEARCH_RESULTS_PATH=results
# SEARCH_TITLE_FIELD=title
# SEARCH_LINK_FIELD=url
# SEARCH_SNIPPET_FIELD=description

# ============ Divers ============
# Dossier persistant (sur Render : le disque monté)
# DATA_DIR=/data
# Rappel quotidien des relances : désactiver avec FOLLOWUP_CRON=off
# FOLLOWUP_DAYS=3
# FOLLOWUP_CRON=0 8 * * *
